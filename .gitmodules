[submodule "fzf"]
	path = fzf
	url = https://github.com/junegunn/fzf.git
[submodule "zshrc/.powerlevel10k"]
	path = zshrc/.powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
[submodule "zshrc/.zsh/zsh-syntax-highlighting"]
	path = zshrc/.zsh/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
[submodule "zshrc/.zsh/zsh-autosuggestions"]
	path = zshrc/.zsh/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
